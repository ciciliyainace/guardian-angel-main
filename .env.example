# ==========================================
# SentinelAI Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env to GitHub or any public repository.
# ==========================================

# ------------------------------------------
# Database Configuration (MongoDB Atlas)
# ------------------------------------------
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=sentinelai

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
SECRET_KEY=<generate_secure_random_key_for_production_min_32_chars>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Initial default user credentials (optional override during first database seed)
INITIAL_ADMIN_PASSWORD=<custom_admin_password_or_leave_blank_for_setup>
INITIAL_ANALYST_PASSWORD=<custom_analyst_password_or_leave_blank_for_setup>

# ------------------------------------------
# Email & SMTP Notification Service
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=revenreven287@gmail.com
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_EMAIL=revenreven287@gmail.com
MAIL_FROM_NAME=SentinelAI Security Team
FRONTEND_BASE_URL=https://guardian-angel-main.vercel.app

# ------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# ------------------------------------------
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ------------------------------------------
# CORS Configuration (Backend)
# In production, set to your actual deployed frontend domain:
# e.g. ["https://<your-frontend>.pages.dev"]
# ------------------------------------------
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","https://<your-frontend>.pages.dev"]

# ------------------------------------------
# Server & Logging Settings
# ------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENABLE_BACKGROUND_WORKERS=true

# ------------------------------------------
# Sensors & Telemetry Paths
# ------------------------------------------
SURICATA_EVE_PATH=datasets/eve.json
SURICATA_CHECKPOINT_FILE=artifacts/suricata_checkpoint.json

# ------------------------------------------
# Machine Learning & Datasets
# ------------------------------------------
MODEL_ARTIFACT_DIR=artifacts
DATASET_DIR=datasets

# ------------------------------------------
# Controlled Firewall Safeguards (Production Defaults)
# KEEP THESE VALUES IN PRODUCTION TO PREVENT SYSTEM LOCKOUT
# ------------------------------------------
FIREWALL_MODE=simulation
ALLOW_FIREWALL_BLOCKING=false
ALERT_ONLY_MODE=true
DEFAULT_BLOCK_DURATION_MINUTES=60
PROTECTED_IPS=["127.0.0.1","::1","192.168.1.1","192.168.0.1","10.0.0.1","8.8.8.8","8.8.4.4","1.1.1.1"]
PROTECTED_NETWORKS=["127.0.0.0/8","::1/128","169.254.0.0/16","224.0.0.0/4","255.255.255.255/32"]

# ------------------------------------------
# Frontend API Base URL (Used during frontend build)
# In production, set to your deployed backend API URL:
# e.g. https://<your-backend-app>.onrender.com/api/v1
# ------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

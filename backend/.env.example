# ==========================================
# SentinelAI Defense System Configuration Template
# ==========================================

# Database Configuration (MongoDB Atlas primary)
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sentinelai

# Security & Authentication
SECRET_KEY=sentinelai-secret-key-change-in-production-must-be-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# SMTP Email Notification Service
# Set these to your authenticated SMTP provider (e.g. SendGrid, Mailgun, AWS SES, Gmail SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_EMAIL=no-reply@sentinelai.local
MAIL_FROM_NAME=SentinelAI Security
FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect
# Obtain Client ID & Secret from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# CORS Allowed Origins (include frontend development and production URLs)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sensors & Log Paths
SURICATA_EVE_PATH=C:\Program Files\Suricata\log\eve.json
SURICATA_CHECKPOINT_FILE=artifacts/suricata_checkpoint.json

# Machine Learning & Datasets
MODEL_ARTIFACT_DIR=artifacts
DATASET_DIR=datasets

# Safe Firewall Enforcement Settings
# Default: simulation mode with blocking disabled
FIREWALL_MODE=simulation
ALLOW_FIREWALL_BLOCKING=false
ALERT_ONLY_MODE=true
DEFAULT_BLOCK_DURATION_MINUTES=60

# Protected Management IPs (Cannot be blocked)
PROTECTED_IPS=["127.0.0.1","::1","192.168.1.1","192.168.0.1","10.0.0.1","8.8.8.8","8.8.4.4","1.1.1.1"]
PROTECTED_NETWORKS=["127.0.0.0/8","::1/128","169.254.0.0/16","224.0.0.0/4","255.255.255.255/32"]

# ==========================================
# SentinelAI Git Ignore Rules
# ==========================================

# 1. Environment & Secret Files (CRITICAL - NEVER UPLOAD)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.cert
*.crt

# 2. Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode, Caches & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. Node.js Dependencies & Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. TanStack Start & Nitro Build Output
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
.vercel/
*.local

# 6. Cloudflare / Wrangler Deploy Artifacts
.wrangler/
.dev.vars

# 7. Local Logs & Databases
logs/
*.log
*.db
*.sqlite
*.sqlite3

# 8. Temporary Sensor Checkpoints & Captures
artifacts/suricata_checkpoint.json
backend/artifacts/suricata_checkpoint.json
datasets/eve.json

# PRESERVE Trained Machine Learning Model Artifacts
!artifacts/*.joblib
!backend/artifacts/*.joblib

# 9. IDE, Editor & OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
